{
  "compilerOptions": {
    "target": "ES6", // Version ECMAScript cible
    "module": "ES6", // Type de module pour l'import/export
    "moduleResolution": "node", // Permet la résolution des modules comme dans Node.js
    "declaration": true, // Génère les fichiers .d.ts (facultatif)
    "outDir": "./dist/Data/systems/polaris", // Répertoire de sortie (Rollup cible /dist également)
    "strict": true, // Active toutes les vérifications strictes de TypeScript
    "esModuleInterop": true, // Interopérabilité avec les modules CommonJS/ES6
    "forceConsistentCasingInFileNames": true, // Assure la cohérence des noms de fichiers
    "skipLibCheck": true // Ignore la vérification des fichiers de bibliothèque (facultatif)
  },
  "include": [
    "./src/polaris.ts",
    "./src/module/**/*.ts" // Inclut le fichier principal et les modules associés
  ],
  "exclude": [
    "node_modules",
    "dist" // Exclut le répertoire de sortie pour éviter la boucle
  ]
}
