<div class="pol3 chat-card module-header">
  {{localize 'POL3.CHAT.Test'}}: <strong>{{rollLabel}}</strong>
</div>
{{> 'systems/polaris/templates/chat/partials/dice-module.hbs' rollTerms=rollBreakdown}}
{{> 'systems/polaris/templates/chat/partials/check-summary.hbs'}}
<div class="pol3 chat-card module-description">
  {{#if (eq state 'none')}}
  {{localize 'POL3.SHOCK.STATE.None'}}
  {{else}}
  {{localize stateKey}}
  {{/if}}
</div>
{{> 'systems/polaris/templates/chat/partials/duration-summary.hbs' duration=duration}}
{{#if (ne state 'none')}}
<button type="button" class="pol3 chat-card module-button"
        data-action="polaris-apply-duration"
        data-duration-type="duration"
        data-value="{{duration.value}}"
        data-unit="{{duration.unit}}"
        data-effect="{{duration.effect}}">
  {{localize 'POL3.SHOCK.ApplyDuration'}}
</button>
{{/if}}
{{#if isCatastrophic}}
  {{localize 'POL3.SHOCK.STATE.Catastrophic'}}:<br>
{{> 'systems/polaris/templates/chat/partials/duration-summary.hbs' duration=catastrophicDuration }}
<button type="button" class="pol3 chat-card module-button"
        data-action="polaris-apply-duration"
        data-duration-type="catastrophicDuration"
        data-value="{{catastrophicDuration.value}}"
        data-unit="{{catastrophicDuration.unit}}"
        data-effect="{{catastrophicDuration.effect}}">
  {{localize 'POL3.SHOCK.ApplyDuration'}}
</button>
{{/if}}
