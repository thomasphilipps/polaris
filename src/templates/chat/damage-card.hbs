<div class="damage-header">
  {{localize 'POL3.DAMAGE.IsHitBy' targetName=targetName weaponName=weaponName}}
</div>
<div>
  {{#if isShockOnly}}
  {{localize 'POL3.DAMAGE.ShockRollDescription'}}
  {{else}}
  {{localize 'POL3.DAMAGE.RollDescription'}}
  {{/if}}
  {{> 'systems/polaris/templates/chat/partials/dice-module.hbs' rollTerms=rollTerms }}
</div>
<div class="damage-description">
  {{#if isShockOnly}}
    {{localize 'POL3.DAMAGE.ShockDamageDescription' zoneLabel=zoneLabel finalDamage=finalDamage}}
  {{else}}
    {{localize 'POL3.DAMAGE.DamageDescription' zoneLabel=zoneLabel finalDamage=finalDamage}}
  {{/if}}<br>
  <strong><em>{{severityText}}</em></strong>
</div>
<details class="details">
  <summary>{{localize 'POL3.SHEETS.GENERAL.Details'}}</summary>
  {{localize 'POL3.DAMAGE.DamageFormula'}}: {{damageFormula}}
  {{> 'systems/polaris/templates/chat/partials/modifier-list.hbs' modifiers=modifiers}}
</details>
