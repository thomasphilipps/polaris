<section>
    {{formField fields.specialization value=source.system.specialization localize=true}}
    {{formField fields.category value=source.system.category localize=true}}
    <fieldset {{fieldDisabled}}>
        <legend>{{localize "POL3.SKILL.SHEET.AssociatedAttributes"}}</legend>
        {{formField fields.firstAttribute value=source.system.firstAttribute localize=true }}
        {{formField fields.secondAttribute value=source.system.secondAttribute localize=true}}
    </fieldset>
    <fieldset {{fieldDisabled}}>
        <legend>{{localize "POL3.SKILL.SHEET.Properties"}}</legend>
        {{formField fields.tags value=source.system.tags localize=true widget=tagsWidget}}
    </fieldset>
</section>