<section
  class="tab sheet-body flexcol {{tabs.description.cssClass}}"
  data-tab="{{tabs.description.id}}"
  data-group="{{tabs.description.group}}"
>
  {{#if isEditable}}
    {{formInput fields.description.fields.public value=source.system.description.public height=300}}
  {{else}}
    <article class="scrollable">{{{source.system.description.public}}}</article>
  {{/if}}
</section>
