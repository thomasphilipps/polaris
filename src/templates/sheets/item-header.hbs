<header class="sheet-header">
  <div class="flexcol">
    <div class="flexrow">
      <img
        src="{{source.img}}"
        data-edit="img"
        title="{{source.name}}"
        height="64"
        width="64"
        alt="{{source.name}}"
      />
      <h1>
        {{#if isEditable}}
          {{formInput item.schema.fields.name value=source.name placeholder="Item Name"}}
        {{else}}
          {{item.system.specializedName}}
        {{/if}}
      </h1>
    </div>
    {{#if isEditable}}
      <div class="reference-field">
        <fieldset>
          <legend>{{localize "POL3.SHEETS.REFERENCE.Label"}}</legend>
          {{formField fields.reference.fields.book value=source.system.reference.book
                      localize=true}}
          {{formField fields.reference.fields.page value=source.system.reference.page
                      localize=true}}
        </fieldset>
      </div>
    {{else}}
      <div class="flexrow">
        <div class="book-reference">
          {{item.system.referenceString}}
        </div>
        <div class="item-info">
          {{{item.system.infoString}}}
        </div>
        <div class="flexrow item-properties">
          {{{item.system.tagString}}}
        </div>
      </div>
    {{/if}}

  </div>

</header>
