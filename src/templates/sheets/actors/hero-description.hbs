<section
  class="tab flexcol {{tabs.description.cssClass}}"
  data-tab="{{tabs.description.id}}"
  data-group="{{tabs.description.group}}">
  <fieldset class="hero-details" {{fieldDisabled}}>
    <legend>{{localize "POL3.SHEETS.DETAILS.Traits"}}</legend>
    {{formField physicalDescription.geneticType value=source.system.physicalDescription.geneticType
                localize=true}}
    {{formField physicalDescription.age value=source.system.physicalDescription.age
                localize=true}}
    {{formField physicalDescription.sex value=source.system.physicalDescription.sex
                localize=true }}
    {{formField physicalDescription.fertile value=source.system.physicalDescription.fertile
                localize=true}}
    {{formField physicalDescription.geographicOrigin
                value=source.system.physicalDescription.geographicOrigin
                localize=true}}
    {{formField physicalDescription.socialOrigin
                value=source.system.physicalDescription.socialOrigin
                localize=true}}
    {{formField physicalDescription.basicTraining
                value=source.system.physicalDescription.basicTraining
                localize=true}}
    {{formField physicalDescription.studies value=source.system.physicalDescription.studies
                localize=true}}
  </fieldset>
  <fieldset class="hero-details">
    <legend>{{localize "POL3.ACTOR.DESCRIPTION.PhysicalDescription"}}</legend>
    {{formField physicalDescription.size value=source.system.physicalDescription.size
                localize=true }}
    {{formField physicalDescription.weight value=source.system.physicalDescription.weight
                localize=true}}
    {{formField physicalDescription.skin value=source.system.physicalDescription.skin
                localize=true}}
    {{formField physicalDescription.build value=source.system.physicalDescription.build
                localize=true}}
    {{formField physicalDescription.hair value=source.system.physicalDescription.hair
                localize=true}}
    {{formField physicalDescription.eyes value=source.system.physicalDescription.eyes
                localize=true}}
    {{formField physicalDescription.handedness value=source.system.physicalDescription.handedness
                localize=true}}
  </fieldset>
</section>
