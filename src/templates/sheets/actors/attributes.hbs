<section class="sheet-section attributes flexcol">
  <h3>{{localize "POL3.ATTRIBUTE.LabelPlural"}}</h3>
  <div>
    <ul class="attribute-list">
      {{#each attributeScores as |attribute|}}
        <li class="attribute flexrow" data-attribute-id="{{attribute.id}}">
          <div class="label">{{localize attribute.abbr}}</div>
          <span class="input value">{{attribute.value}}</span>
          <a class="button icon fa-solid fa-gears" data-action="configureAttribute"
             data-tooltip="Configure"></a>
          <a class="button icon fa-solid fa-dice-d20" data-action="testAttribute"
             data-tooltip="Test {{localize attribute.label}}"></a>
        </li>
      {{/each}}
    </ul>
  </div>

  <h3>{{localize "POL3.ATTRIBUTE.SecondaryAttributes"}}</h3>
  <div>
    <ul class="secondary-attribute-list">
      {{#each secondaryAttributeScores as |secAttribute|}}
        <li class="attribute flexrow" data-attribute-id="{{secAttribute.id}}">
          <div class="label">{{localize secAttribute.label}}</div>
          <span class="input value">{{secAttribute.value}}</span>
          <a class="button icon fa-solid fa-dice-d20" data-action="testAttribute"
             data-tooltip="Test {{localize secAttribute.label}}"></a>
        </li>
      {{/each}}
    </ul>
  </div>

  <h3>{{localize "POL3.ATTRIBUTE.Speed"}}</h3>
  <div>
    <ul class="speed-attributes">
      li.attribute.flexrow
    </ul>
  </div>
</section>
