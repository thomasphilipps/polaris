<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img src="{{source.img}}" data-edit="img" title="{{source.name}}" height="64" width="64" />
    <h1><input
        name="name"
        type="text"
        value="{{source.name}}"
        placeholder="{{localize 'Name'}}"
      /></h1>
  </header>
  <p>"{{item.isPhysical}}"</p>
</form>